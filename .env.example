# Copy this file to .env and fill in your values.

# Required: get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: any chat model listed in your Groq console
GROQ_MODEL=openai/gpt-oss-120b

# Optional: local Hugging Face embedding model (Groq does not provide embeddings)
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional: LangSmith tracing
# LANGCHAIN_API_KEY=

# Optional: Cohere reranker
COHERE_API_KEY=
ADMIN_PASSWORD=